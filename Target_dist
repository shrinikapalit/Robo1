# Robot simulator driving and checking for obstacles

position = 0
target_distance = 20
obstacle_distance = 12
speed = 2

print("Starting robot simulator...")
print("Target distance:", target_distance)
print("Obstacle is at:", obstacle_distance)

# main loop - robot should keep moving forward until hitting the target
while position < target_distance:
    # check if the robot would hit the obstacle
    if position >= obstacle_distance:
        print("Oops, obstacle detected ahead, stopping robot.")
        break

    position = (position + speed)
    print("The robot moved forward, it's now at position:", position)

# after loop figure out what actually happened
if position < target_distance:
    print("The robot stopped early due to the obstacle.")
else:
    print("The robot made it to the target distance1")

print("Simulation done. Final position:", position)

